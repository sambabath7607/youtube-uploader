# Copier ce fichier en .env puis remplir les valeurs. Ne jamais envoyer .env sur GitHub.

# Clé secrète de Django (longue et aléatoire) :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# True sur le PC seulement ; False sur le serveur
DJANGO_DEBUG=True
# Noms de domaine acceptés, séparés par des virgules (serveur : api.batchcodeia.com)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Clé qui chiffre les jetons Google en base. La garder précieusement : si elle change, chaque utilisateur
# doit reconnecter sa chaîne. Pour en créer une :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Adresse de retour après la connexion Google (doit être déclarée dans Google Cloud)
# Serveur : https://api.batchcodeia.com/youtube/oauth/callback/
OAUTH_REDIRECT_URI=http://127.0.0.1:8000/youtube/oauth/callback/

# Connecteur MCP : adresse de l'API qu'il appelle (vide = https://api.batchcodeia.com/youtube/api/v1/videos/)
MCP_ADRESSE_API=

# Service de voix (Modal) : clé du compte Modal, créée avec « modal token new » (rangée dans ~/.modal.toml)
# ou fournie ici. Ne jamais l'envoyer sur GitHub.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Courriels (facultatif) : sans EMAIL_HOST, ils sont seulement affichés dans le journal du serveur.
# Exemple Brevo : EMAIL_HOST=smtp-relay.brevo.com, EMAIL_PORT=2525
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Batch Code IA <noreply@batchcodeia.com>
# Adresse qui reçoit les messages de la page Contact et les avis « liste d'attente »
SUPPORT_EMAIL=support@batchcodeia.com

# Liste d'attente tant que Google n'a pas vérifié l'application (100 utilisateurs à vie) :
# au-delà de ce nombre de comptes ayant connecté une chaîne, « Connecter ma chaîne » propose la liste d'attente.
SEUIL_LISTE_ATTENTE_GOOGLE=90
# Mettre True quand Google a vérifié l'application : la limite disparaît
GOOGLE_APPLICATION_VERIFIEE=False

# --- Offres et pont (lot 4) ---
# Secret partagé avec le site vitrine : EXACTEMENT la même valeur dans le .env du site vitrine (PONT_SECRET).
# Pour en créer un :  python -c "import secrets; print(secrets.token_hex(32))"
# Vide = le pont refuse tout appel. À garder aussi dans un gestionnaire de mots de passe.
PONT_SECRET=
# Pages du site vitrine (vide = adresses par défaut de batchcodeia.com)
URL_PAIEMENT_PRO=
URL_GERER_ABONNEMENT=
# Tableau « Coûts par client » de l'administration : tarif Modal en $ par minute (à mesurer, tâche L2)
COUT_MODAL_MINUTE_VOIX=
COUT_MODAL_MINUTE_VIDEO=
