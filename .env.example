# Copier ce fichier en .env puis remplir les valeurs. Ne jamais envoyer .env sur GitHub.

# Clé secrète de Django (longue et aléatoire) :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# True sur le PC seulement ; False sur le serveur
DJANGO_DEBUG=True
# Noms de domaine acceptés, séparés par des virgules (serveur : api.batchcodeia.com)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Clé qui chiffre les jetons Google en base. La garder précieusement : si elle change, chaque utilisateur
# doit reconnecter sa chaîne. Pour en créer une :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Adresse de retour après la connexion Google (doit être déclarée dans Google Cloud)
# Serveur : https://api.batchcodeia.com/youtube/oauth/callback/
OAUTH_REDIRECT_URI=http://127.0.0.1:8000/youtube/oauth/callback/

# Connecteur MCP : adresse de l'API qu'il appelle (vide = https://api.batchcodeia.com/youtube/api/v1/videos/)
MCP_ADRESSE_API=
